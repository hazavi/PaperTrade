# ASP.NET Core API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5044
Cors__AllowedOrigins__0=http://localhost:5173

# Vite frontend
VITE_API_BASE_URL=http://localhost:5044

# PostgreSQL
POSTGRES_DB=papertrade
POSTGRES_USER=papertrade
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Market data
FINNHUB_API_KEY=replace_with_your_finnhub_api_key
MARKET_DATA_WORKER_ENABLED=true

# Docker host ports
API_PORT=5044
WEB_PORT=5173
