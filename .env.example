# ASP.NET Core API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5044
Cors__AllowedOrigins__0=http://localhost:5173

# Vite frontend
VITE_API_BASE_URL=http://localhost:5044

# PostgreSQL
POSTGRES_DB=papertrade
POSTGRES_USER=papertrade
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Market data
FINNHUB_API_KEY=replace_with_your_finnhub_api_key
TWELVE_DATA_API_KEY=replace_with_your_twelve_data_api_key
EXPANDED_ASSETS_ENABLED=false
EXPANDED_ASSETS_DISPLAY_RIGHTS_CONFIRMED=false
MARKET_DATA_WORKER_ENABLED=true
MARKET_DATA_INTERVAL_SECONDS=5

# Optional alert email delivery. Users must also opt in on the Alerts page.
Alerts__Email__Enabled=false
Alerts__Email__Host=
Alerts__Email__Port=587
Alerts__Email__From=
Alerts__Email__Username=
Alerts__Email__Password=

# Paper order simulation (basis points; 1 bp = 0.01%)
TRADING_FEE_BPS=1
TRADING_SLIPPAGE_BPS=0

# Docker host ports
API_PORT=5044
WEB_PORT=5173
